{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vellum-shared-books",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "vars": {
    "SUPABASE_URL": "https://cdsmygejvbusxnzscghk.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_vOcmwQ37QIVBdx0cpOTWSA_KEuSt6Jy"
  },
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "vellum-shared-books"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
